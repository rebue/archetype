<script lang="ts" setup>
// api
import { ${pojoMeta.className}Api, ${pojoMeta.className}Url } from '~/api/${project}/${pojoMeta.className}Api';
// store
import { useThemeStore } from '~/store/ThemeStore';
// cfg
import { searchFormSchema } from './cfg/form.cfg';
import { tableColumns } from './cfg/table.cfg';
import type { ActionItem } from '~/component/rebue/rebue-table/type';
// hook
import { useBaseCRUD } from '~/hook/api/useBaseCRUD';
import { useFileDownload } from '~/hook/api/useFileDownload';
// vo
import type { ${pojoMeta.className}Vo } from '~/vo/${project}/${pojoMeta.className}Vo';

// 主题相关配置仓库
const { cssToken } = useThemeStore();

// 初始化 CRUD HOOK
const { isOpenDrawer, setTransData, setDrawVisible, reqDelFetch, reqDelSelectedFetch } =
    useBaseCRUD<${pojoMeta.className}Vo>(${pojoMeta.className}Api);

// 初始化下载HOOK
const { useSimpleDownload } = useFileDownload();

// 相关 Ref 对象
const tableRef = ref();
const tableData = ref<any[]>([]);

/**
 * 表格操作列配置方法
 * @param {any} record 当前点击项数据对象
 * @return {ActionItem[]} 返回操作配置数据
 */
const tableActions = (record: any): ActionItem[] => [
    {
        label: '编辑',
        onClick: onClickEdit.bind(null, record),
    },
    {
        label: '删除',
        color: '#e74c3c',
        popConfirm: {
            title: '是否确认删除？',
            onConfirm: onClickDel.bind(null, record),
        },
    },
];

/**
 * 点击添加${pojoMeta.title}方法
 */
const onClickAdd${pojoMeta.className} = () => {
    setTransData({ handleMethod: 'add' });
    setDrawVisible(true);
};

/**
 * 点击编辑方法
 * @param {${pojoMeta.className}Vo} record 当前点击项数据对象
 */
const onClickEdit = (record: ${pojoMeta.className}Vo) => {
    setTransData({ ...record, handleMethod: 'edit' });
    setDrawVisible(true);
};

/**
 * 点击删除方法
 * @param {${pojoMeta.className}Vo} record 当前点击项数据对象
 */
const onClickDel = async (record: any) => {
    const { setLoading, reload } = unref(tableRef);
    setLoading(true);
    await reqDelFetch({ id: record.id })
        .then(() => reload())
        .catch(() => setLoading(false));
};

/**
 * 点击删除选中项方法
 */
const onClickDelSelected = async () => {
    const { getSelectedData, resetSelectedData, setLoading, reload } = unref(tableRef);
    const { keys } = getSelectedData();

    setLoading(true);
    await reqDelSelectedFetch({ ids: keys })
        .then(() => reload())
        .catch(() => setLoading(false));

    resetSelectedData();
};

/**
 * 点击导出的方法
 */
const onClick${pojoMeta.className}Export = async () => {
    const { getSelectedData, setLoading } = unref(tableRef);
    const { keys } = getSelectedData();

    setLoading(true);
    useSimpleDownload({ url: ${pojoMeta.className}Url.export, ids: keys });
    setLoading(false);
};

/**
 * 高级查询动作完成事件
 * @param {any} data 搜素相关数据
 */
const advancedSearchActionCompleteEvent = (data: any) => {
    unref(tableRef).setParams((params: any) => ({ ...params, ...data }));
    unref(tableRef).reload();
};
</script>

<template>
    <RebueMng>
        <template #header>
            <RebueSearch
                class="search"
                :schemas="searchFormSchema"
                is-show
                @action-complete="advancedSearchActionCompleteEvent"
            />
        </template>

        <template #content>
            <RebueTable
                ref="tableRef"
                :api="${pojoMeta.className}Api.search"
                :columns="tableColumns"
                :data-source="tableData"
                :row-selection="true"
                show-select-tip
                row-key="id"
            >
                <template #header-left>
                    <a-space warp>
                        <a-button ghost type="primary" @click="onClickAdd${pojoMeta.className}">
                            <template #icon>
                                <PlusOutlined />
                            </template>
                            {{ $t('新增') }}
                        </a-button>
                        <a-popconfirm
                            title="请确认要删除已选择项"
                            ok-text="Yes"
                            cancel-text="No"
                            @confirm="onClickDelSelected"
                        >
                            <a-button ghost type="primary" danger>
                                <template #icon>
                                    <DeleteOutlined />
                                </template>
                                {{ $t('删除') }}
                            </a-button>
                        </a-popconfirm>
                        <RebueUpload :api="${pojoMeta.className}Api.import" :listType="'text'" :showUploadList="false">
                            <a-button type="primary" ghost>
                                <template #icon>
                                    <ImportOutlined />
                                </template>
                                导入
                            </a-button>
                        </RebueUpload>
                        <a-button ghost type="primary" @click="onClick${pojoMeta.className}Export  ">
                            <template #icon>
                                <ExportOutlined />
                            </template>
                            {{ $t('导出') }}
                        </a-button>
                    </a-space>
                </template>
                <template #bodyCell="{ column, record }">
                    <template v-if="['action'].includes(column.dataIndex as string)">
                        <Action :actions="tableActions(record)" />
                    </template>
                </template>
            </RebueTable>
        </template>
    </RebueMng>

    <!-- 添加 ${pojoMeta.title} 弹窗 -->
    <${pojoMeta.className}EditForm v-model:visible="isOpenDrawer" @success="() => tableRef?.reload()" />

</template>

<style lang="scss" scoped>
$colorBgContainer: v-bind('cssToken.colorBgContainer');
.mng__header {
    @include flexBox();
    gap: 10px;
    padding: 10px;
    background-color: #fff;

    &__btn {
        @include flexBox();
        align-items: center;
        gap: 10px;
    }
}
</style>
