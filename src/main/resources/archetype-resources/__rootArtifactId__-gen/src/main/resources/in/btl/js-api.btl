import { Ro } from '~/ro/Ro';
import { request } from '~/util/request';

export const ${pojoMeta.className}Url = {
    export: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/export',
};

export const ${pojoMeta.className}Api = {
    /**
     * 获取${pojoMeta.className}列表
     * @param {any} params 参数对象
     */
    list(params?: any): Promise<Ro> {
        // 发出get请求
        return request.get({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/list',
            params: { ...params },
        });
    },

    search(params?: any): Promise<Ro> {
        // 发出get请求
        return request.get({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/search',
            params: { ...params },
        });
    },

    del(params?: any): Promise<Ro> {
        return request.del({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}',
            params: { ...params },
        });
    },

    add(data?: any): Promise<Ro> {
        return request.post({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}',
            data: { ...data },
        });
    },

    update(data?: any): Promise<Ro> {
        return request.put({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}',
            data: { ...data },
        });
    },

    searchById(params?: any): Promise<Ro> {
        return request.get({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/search-by-id',
            params: { ...params },
        });
    },

    batchDeletionDevice(data?: any): Promise<Ro> {
            return request.post({
                url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/${pojoMeta.lowerHyphenNameWithoutPrefix}-del',
                data: { ...data },
            });
        },

    import(data?: any): Promise<Ro> {
        return request.post({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/import',
            data,
        });
    },

    export(params?: any): Promise<Ro> {
        return request.get({
            url: '/${project}-svr/${project}/${pojoMeta.lowerHyphenNameWithoutPrefix}/export',
            params: { ...params },
        });
    },
};
