             @{pojoMeta.className}ModifyTo to =  @{pojoMeta.className}ModifyTo.builder().id(@{pojoMeta.ids[0].name}).isDeleted(true).build();
             getThisSvc().modifyById(to);
         } else {
             super.delById(@{pojoMeta.ids[0].name});
         }
     }
