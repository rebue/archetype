    /**
     * 重写add方法，实现添加时，自动设置seqNo
     *
     * @param to 添加的参数
     * @codgen.generated 自动生成，如需修改，请删除本行
     */
    @Override
    @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.SERIALIZABLE)
    public @{pojoMeta.className}Vo add(@{pojoMeta.className}AddTo to) {
        try {
            Map<String, Object> param    = MapUtils.builder().orderBy(@{pojoMeta.className}Vo::getSeqNo).desc().build();
            @{pojoMeta.className}Vo   vo = getThisSvc().beanSearchOne(param);
            Optional.ofNullable(vo.getSeqNo()).ifPresentOrElse( i -> to.setSeqNo(@{castClass}(i + 1)), () -> to.setSeqNo(@{castClass}0));
            return super.add(to);
        } catch (PessimisticLockingFailureException e) {
            throw new IllegalArgumentException("已有相关操作正在进行，稍后重试", e);
        }
    }

    /**
     * 重排seqNo
     *
     * @param to 修改的参数
     * @codgen.generated 自动生成，如需修改，请删除本行
     */
    @Override
    @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.SERIALIZABLE)
    public void modifySeqNo(@{pojoMeta.className}ModifyTo to) {
        try {
            @{pojoMeta.className}Vo vo       = getThisSvc().getById(to.getId());
            @{pojoMeta.className}Vo targetVo = getThisSvc().getById(to.getTargetId());
            @{propertyClassSimpleName} before   = vo.getSeqNo();
            int      after    = targetVo.getSeqNo();
            if (before < after && to.getOpSeqNoDic() == OpSeqNoDic.UP) {
                after -= 1;
            }
            if (before > after && to.getOpSeqNoDic() == OpSeqNoDic.DOWN) {
                after += 1;
            }
            to.setSeqNo(@{castClass}after);
            if (after > before) {
                mybatisMapper.updateSeqNo(before, @{castClass}after, "-", null);
            } else {
                mybatisMapper.updateSeqNo(@{castClass}after, before, "+", null);
            }
            super.modifyById(to);
        } catch (PessimisticLockingFailureException e) {
            throw new IllegalArgumentException("已有相关操作正在进行，稍后重试", e);
        }
    }

