<script lang="ts" setup>
// cfg
import { ${pojoMeta.className}Vo } from '~/vo/${project}/${pojoMeta.className}Vo';
import { editFormSchema } from './cfg/form.cfg';
// hook
import { useBaseCRUD } from '~/hook/api/useBaseCRUD';
import { ${pojoMeta.className}Api } from '~/api/${project}/${pojoMeta.className}Api';

// 应急资源请求 hook
const { transData, detailsData, isDetailsLoading, reqDetailsFetch, reqSubmitFetch } =
    useBaseCRUD<${pojoMeta.className}Vo>(${pojoMeta.className}Api);

const emit = defineEmits(['success']);

const drawerRef = ref();
const formRef = ref();

const drawerTitle = computed(() => {
    return unref(transData)?.handleMethod === 'add' ? '新增${pojoMeta.title}' : '编辑${pojoMeta.title}';
});

/**
 * 点击确认方法
 */
const onClickConfirm = async () => {
    const { setLoading, close } = unref(drawerRef);
    const { validate, getFormData } = unref(formRef);
    await validate();

    // 获取表单数据
    const formData = getFormData();

    // 组装请求数据
    const reqData = {
        ...formData,
    };

    // 发起提交请求，并开启弹窗按钮 loading 效果
    setLoading(true);
    reqSubmitFetch(reqData)
        .then(() => {
            setLoading(false);
            close();
            emit('success');
        })
        .catch(() => setLoading(false));
};

/**
 * drawer 显示/隐藏事件
 */
const drawerVisibleChangeEvent = async (visible: boolean) => {
    if (!visible || unref(transData)?.handleMethod === 'add') return;

    // 获取详情数据，并设置表单值
    await reqDetailsFetch({ id: unref(transData)?.id });

    const editData = {
        ...unref(detailsData),
    };

    unref(formRef)?.setFieldsValue({ ...editData });
};

/**
 * drawer 完全关闭事件
 * @description 在关闭后进行控件清除，否则会看到闪动问题
 */
const drawerAfterCloseEvent = () => {
    unref(formRef)?.resetFormData();
};
</script>

<template>
    <RebueDrawer
        ref="drawerRef"
        v-bind="$attrs"
        :title="drawerTitle"
        :is-loading="isDetailsLoading"
        :after-close="drawerAfterCloseEvent"
        @change="drawerVisibleChangeEvent"
        @confirm="onClickConfirm"
    >
        <RebueForm ref="formRef" :schemas="editFormSchema" />
    </RebueDrawer>
</template>

<style lang="scss" scoped></style>
